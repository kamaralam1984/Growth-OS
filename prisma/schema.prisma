enum TaxRuleType {
  GST
  VAT
  SALES_TAX
  NONE
}

// One real rate per billing account, resolved at subscribe/renew time from
// src/lib/billing/tax-rates.ts's static country/region table (documented
// there as approximate, real-world rates that need periodic review — never
// a fabricated placeholder percentage).
model TaxProfile {
  id               String      @id @default(cuid())
  billingAccountId String      @unique
  country          String
  region           String?
