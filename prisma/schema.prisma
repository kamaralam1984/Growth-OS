  firstDownloadedAt DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  // Dedup guard for the Scheduler Service's proposal-follow-up-reminder job
  // (src/lib/scheduler/registry.ts) — set once a real reminder has been sent
  // for this still-SENT proposal, so the job never re-notifies every run.
  reminderSentAt    DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead             Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents        Document[]
  recommendations  Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([dealId])
}

model Document {
  id                       String  @id @default(cuid())
  organizationId           String
  name                     String
  // Relative path under the app-local storage/documents/ directory — never
  // under public/, always streamed through an auth-gated route handler.
  storageKey               String
  mimeType                 String
  sizeBytes                Int
  folder                   String?
  linkedCompanyId          String?
  linkedProjectId          String?
  linkedProposalId         String?
  linkedDealId             String?
  linkedQuotationId        String?
  linkedContractId         String?
  linkedInvoiceId          String?
  linkedBusinessDocumentId String?
  linkedTaskId             String?
  uploadedByUserId         String?
  // Gates whether the Client Portal's file list can show this row — never
  // shown to a client by default.
  visibleToClient          Boolean @default(false)

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedCompany          Company?          @relation(fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  linkedProject          Project?          @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  linkedProposal         Proposal?         @relation(fields: [linkedProposalId], references: [id], onDelete: SetNull)
  linkedDeal             Deal?             @relation(fields: [linkedDealId], references: [id], onDelete: SetNull)
  linkedQuotation        Quotation?        @relation(fields: [linkedQuotationId], references: [id], onDelete: SetNull)
  linkedContract         Contract?         @relation(fields: [linkedContractId], references: [id], onDelete: SetNull)
  linkedInvoice          Invoice?          @relation(fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  linkedBusinessDocument BusinessDocument? @relation(fields: [linkedBusinessDocumentId], references: [id], onDelete: SetNull)
  linkedTask             Task?             @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  uploadedByUser         User?             @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([linkedTaskId])
}

// ============================= Phase 12: Enterprise Document Generation =============================
//
// Proposal (extended above) stays the flagship AI-authored document.
// Quotation/Contract/Invoice get dedicated models because they carry real
// structured/relational data (line items, tax math, signature/payment
// state) that Proposal doesn't. Every other "generate title + rich text,
// link to a company/deal/project, track status" document kind (NDA, MSA,
// SLA, Terms, Privacy Agreement, Acceptance Letter, Delivery Certificate,
// Scope of Work, Requirement Specification, Technical Architecture,
// Project Roadmap, Risk Register, Acceptance Criteria, Project Plan,
// Business Report) shares ONE model (BusinessDocument) discriminated by
// `kind` — building 14 near-identical tables would be pure duplication.
//
// DocumentVersion and Signature are intentionally polymorphic (docKind +
// docId, no hard FK) since Prisma has no native polymorphic relation and
// a real FK would require picking one target table — the same
// loose-reference pattern already used by Activity.metadata's dealId.
// Referential integrity for these two is enforced in application code.

enum DocumentKind {
  PROPOSAL
  QUOTATION
  CONTRACT
  INVOICE
  BUSINESS_DOCUMENT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id                 String          @id @default(cuid())
  organizationId     String
  companyId          String?
  contactId          String?
  dealId             String?
  quotationNumber    String
  title              String
  status             QuotationStatus @default(DRAFT)
  pricingModel       PricingModel?
  currency           String?
  subtotal           Float           @default(0)
  discountPercent    Float?
  discountAmount     Float           @default(0)
  taxPercent         Float?
  taxAmount          Float           @default(0)
  grandTotal         Float           @default(0)
  validUntil         DateTime?
  notes              String?         @db.Text
  terms              String?         @db.Text
  generatedByAgentId String?
  createdByUserId    String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance?    @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?               @relation("QuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems        QuotationLineItem[]
  documents        Document[]
  recommendations  Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([dealId])
}

model QuotationLineItem {
  id              String @id @default(cuid())
  quotationId     String
  description     String
  quantity        Float  @default(1)
  rate            Float  @default(0)
  discountPercent Float?
  amount          Float  @default(0)
  order           Int    @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

enum ContractType {
  SOFTWARE_DEVELOPMENT_AGREEMENT
  AMC_AGREEMENT
  MAINTENANCE_AGREEMENT
  SUPPORT_AGREEMENT
  IMPLEMENTATION_AGREEMENT
  CONSULTING_AGREEMENT
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  REJECTED
  EXPIRED
  ARCHIVED
}

model Contract {
  id                 String         @id @default(cuid())
  organizationId     String
  companyId          String?
  dealId             String?
  clientId           String?
  contractNumber     String
  type               ContractType
  title              String
  content            String         @db.Text
  status             ContractStatus @default(DRAFT)
  value              Float?
  startDate          DateTime?
  endDate            DateTime?
  generatedByAgentId String?
  createdByUserId    String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  signedAt          DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("ContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents        Document[]
  recommendations  Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([dealId])
}

enum InvoiceType {
  STANDARD
  GST
  RECURRING
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  VOID
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  companyId       String?
  dealId          String?
  clientId        String?
  invoiceNumber   String
  type            InvoiceType   @default(STANDARD)
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  currency        String?
  subtotal        Float         @default(0)
  discountPercent Float?
  discountAmount  Float         @default(0)
  taxPercent      Float?
  taxAmount       Float         @default(0)
  grandTotal      Float         @default(0)
  amountPaid      Float         @default(0)
  isRecurring     Boolean       @default(false)
  recurrenceRule  String?
  notes           String?       @db.Text
  terms           String?       @db.Text
  createdByUserId String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?
  paidAt            DateTime?
  // Dedup guard for the Scheduler Service's invoice-due-reminder job
  // (src/lib/scheduler/registry.ts) — set once a real reminder has been sent
  // for this unpaid invoice, so the job never re-notifies every run.
  reminderSentAt    DateTime?

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal            Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems       InvoiceLineItem[]
  documents       Document[]
  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([dealId])
  @@index([status])
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  rate        Float  @default(0)
  amount      Float  @default(0)
  order       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum BusinessDocumentKind {
  NDA
  MSA
  SLA
  TERMS
  PRIVACY_AGREEMENT
  ACCEPTANCE_LETTER
  DELIVERY_CERTIFICATE
  SCOPE_OF_WORK
  REQUIREMENT_SPECIFICATION
  TECHNICAL_ARCHITECTURE
  PROJECT_ROADMAP
  RISK_REGISTER
  ACCEPTANCE_CRITERIA
  PROJECT_PLAN
  BUSINESS_REPORT
}

enum BusinessDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  ARCHIVED
}

model BusinessDocument {
  id                 String                 @id @default(cuid())
  organizationId     String
  companyId          String?
  dealId             String?
  projectId          String?
  kind               BusinessDocumentKind
  title              String
  content            String                 @db.Text
  status             BusinessDocumentStatus @default(DRAFT)
  generatedByAgentId String?
  createdByUserId    String?

  trackingToken     String?   @unique
  openCount         Int       @default(0)
  firstOpenedAt     DateTime?
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?
  sentAt            DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generatedByAgent AIAgentInstance? @relation(fields: [generatedByAgentId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("BusinessDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents        Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([dealId])
  @@index([kind])
}

model DocumentTemplate {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  docKind         DocumentKind
  category        DocumentIndustry?
  businessDocKind BusinessDocumentKind?
  contractType    ContractType?
  content         String                @db.Text
  isDefault       Boolean               @default(false)
  createdByUserId String?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("DocumentTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([docKind])
}

model DocumentVersion {
  id              String       @id @default(cuid())
  organizationId  String
  docKind         DocumentKind
  docId           String
  versionNumber   Int
  snapshotTitle   String
  snapshotContent String       @db.Text
  changeNote      String?
  changedByUserId String?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedByUser User?        @relation("DocumentVersionChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([docKind, docId])
}

enum SignatureProvider {
  MANUAL
  DOCUSIGN
  ADOBE_SIGN
  DROPBOX_SIGN
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

// Digital-signature-ready architecture: MANUAL is fully implemented (a
// public token-based signing page records signerName/typedSignature/IP and
// flips the parent document to SIGNED). DOCUSIGN/ADOBE_SIGN/DROPBOX_SIGN
// are modeled so a future phase can wire in a real vendor integration
// without a schema change — no real API calls are made to any of them
// today (no vendor credentials exist in this environment).
model Signature {
  id                 String            @id @default(cuid())
  organizationId     String
  docKind            DocumentKind
  docId              String
  signerName         String
  signerEmail        String
  provider           SignatureProvider @default(MANUAL)
  status             SignatureStatus   @default(PENDING)
  signatureToken     String            @unique
  typedSignature     String?
  signedAt           DateTime?
  ipAddress          String?
  requestedByUserId  String?
  // Third-party envelope id (DocuSign envelopeId, Adobe Sign agreementId,
  // Dropbox Sign signature_request_id) — set only once a real envelope is
  // created via the Integration Layer (src/lib/integrations/*). Null for
  // MANUAL signatures. The webhook receivers under src/app/api/webhooks/
  // look a Signature up by this field to mark it SIGNED on a real
  // provider-pushed event, never by polling/guessing.
  providerEnvelopeId String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUser User?        @relation("SignatureRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([provider, providerEnvelopeId])
  @@index([organizationId])
  @@index([docKind, docId])
}

// ===== Phase 17: Enterprise Knowledge Base / AI Long-Term Memory / RAG Engine =====
// KnowledgeArticleKind/Status/visibility are additive to the pre-existing
// flat KnowledgeArticle (createdAt/updatedAt/tags/knowledgeBaseId unchanged,
// every existing row is valid under the new defaults: kind ARTICLE, status
// PUBLISHED — the old model had no draft concept, so treating pre-existing
// rows as already-published is the only honest default). `tags String[]`
// stays as the simple free-text tag column existing UI already reads/writes
// (src/app/dashboard/knowledge-base/_components/article-form.tsx); the new
// `tagEntities`/KnowledgeTag relation below is an additional, real
// tag-as-entity system (autocomplete, per-tag article counts, tag pages) —
// both coexist, neither replaces the other.
enum KnowledgeArticleKind {
  ARTICLE
  FAQ
  POLICY
  PROCEDURE
  PLAYBOOK
  TEMPLATE
  MEETING_NOTES
  SOP
  TECHNICAL_DOC
  SALES_DOC
  HR_DOC
  FINANCE_DOC
}

enum KnowledgeArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

// PRIVATE: only createdByUserId can read/edit. ORG: every active member of
// the organization. There is no Department model anywhere else in this
// schema, so a DEPARTMENT visibility tier isn't backed by a real table yet —
// left out rather than faked; ORG is the honest ceiling today.
enum KnowledgeArticleVisibility {
  PRIVATE
  ORG
}

model KnowledgeArticle {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  title           String
  content         String   @db.Text
  tags            String[]
  createdByUserId String?

  categoryId String?
  kind       KnowledgeArticleKind       @default(ARTICLE)
  status     KnowledgeArticleStatus     @default(PUBLISHED)
  visibility KnowledgeArticleVisibility @default(ORG)

  reviewedByUserId String?
  reviewedAt       DateTime?

  knowledgeBase KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdByUser User?                     @relation("ArticleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  category      KnowledgeCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagEntities   KnowledgeTag[]            @relation("ArticleTags")
  versions      KnowledgeArticleVersion[]
  attachments   KnowledgeAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([categoryId])
}

model KnowledgeCategory {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     KnowledgeCategory[] @relation("CategoryHierarchy")
  articles     KnowledgeArticle[]

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

model KnowledgeTag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  slug           String

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     KnowledgeArticle[] @relation("ArticleTags")

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// Full-content snapshot taken on every real edit (not a diff store) — same
// "keep the whole prior version" simplicity as DocumentVersion elsewhere in
// this schema, not a byte-diff engine.
model KnowledgeArticleVersion {
  id             String  @id @default(cuid())
  articleId      String
  title          String
  content        String  @db.Text
  editedByUserId String?

  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editedByUser User?            @relation("KnowledgeArticleVersionEditor", fields: [editedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([articleId])
}

model KnowledgeAttachment {
  id               String  @id @default(cuid())
  articleId        String
  filename         String
  storageKey       String  @db.Text
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?

  article        KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  uploadedByUser User?            @relation("KnowledgeAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([articleId])
}

// ===== RAG Engine: document ingestion, chunking, embeddings =====

enum IngestedDocumentSourceKind {
  UPLOAD
  KNOWLEDGE_ARTICLE
  DEAL
  PROJECT
  MEETING
  PROPOSAL
}

enum IngestedDocumentStatus {
  PENDING
  PARSING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

// One row per real ingested source (an uploaded file, or a pointer at an
// existing KnowledgeArticle/Deal/Project/Meeting/Proposal this org already
// has) — DocumentChunk rows are its real, persisted chunks; nothing here is
// a cache that can be silently dropped, since Embedding rows reference
// DocumentChunk.id directly.
model IngestedDocument {
  id               String                     @id @default(cuid())
  organizationId   String
  title            String
  sourceKind       IngestedDocumentSourceKind
  sourceId         String?
  originalFilename String?
  mimeType         String?
  storageKey       String?                    @db.Text
  status           IngestedDocumentStatus     @default(PENDING)
  error            String?                    @db.Text
  uploadedByUserId String?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser User?           @relation("IngestedDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  chunks         DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

model DocumentChunk {
  id                 String @id @default(cuid())
  ingestedDocumentId String
  organizationId     String
  chunkIndex         Int
  content            String @db.Text
  tokenCount         Int?

  ingestedDocument IngestedDocument @relation(fields: [ingestedDocumentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ingestedDocumentId])
  @@index([organizationId])
}

enum EmbeddingProvider {
  OPENAI
  VOYAGE
  COHERE
  BGE
  JINA
}

enum EmbeddingSourceType {
  KNOWLEDGE_ARTICLE
  AGENT_MEMORY
  DOCUMENT_CHUNK
}

// vector is stored as a plain Float[] (a real, always-populated Postgres
// array column) rather than an Unsupported("vector(n)") pgvector column,
// because the `vector` Postgres extension is not installed in every
// deployment target — this column always works with zero extra
// infrastructure. src/lib/rag/vector-store.ts detects at runtime whether
// pgvector is actually available (`SELECT 1 FROM pg_extension WHERE
// extname='vector'`) and, if so, ALSO maintains a native
// `document_chunk_embedding_vector`-style side table (see
// prisma/optional-pgvector-upgrade.sql) for fast ANN search — this Float[]
// column is the one column every retrieval path can always fall back to,
// so it is never optional and never left stale.
model Embedding {
  id             String              @id @default(cuid())
  organizationId String
  sourceType     EmbeddingSourceType
  sourceId       String
  provider       EmbeddingProvider
  model          String
  dimensions     Int
  vector         Float[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceType, sourceId, provider])
  @@index([organizationId, sourceType])
}

// ===== Knowledge Graph =====

enum GraphEntityType {
  CLIENT
  COMPANY
  PROJECT
  EMPLOYEE
  MEETING
  TASK
  DOCUMENT
  EMAIL
  DEAL
  AI_DECISION
  KNOWLEDGE_ARTICLE
}

model KnowledgeGraphNode {
  id             String          @id @default(cuid())
  organizationId String
  entityType     GraphEntityType
  entityId       String
  label          String
  metadata       Json?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outgoing     Relationship[] @relation("FromNode")
  incoming     Relationship[] @relation("ToNode")

  createdAt DateTime @default(now())

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, entityType])
}

enum RelationshipType {
  WORKS_ON
  OWNS
  BELONGS_TO
  ATTENDED
  MENTIONS
  RELATED_TO
  DECIDED_IN
  ASSIGNED_TO
  AUTHORED
}

model Relationship {
  id             String           @id @default(cuid())
  organizationId String
  fromNodeId     String
  toNodeId       String
  type           RelationshipType
  weight         Float?           @default(1)
  metadata       Json?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromNode     KnowledgeGraphNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       KnowledgeGraphNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// ===== RAG answer grounding, search history, bookmarks =====

// One row per (source chunk/article/memory) an AI answer or search result
// actually drew from — queryId groups every Citation belonging to one
// answer/search turn so the UI can render "Sources" together.
model Citation {
  id             String              @id @default(cuid())
  organizationId String
  queryId        String
  sourceType     EmbeddingSourceType
  sourceId       String
  snippet        String              @db.Text
  relevanceScore Float

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, queryId])
}

model SearchHistory {
  id               String  @id @default(cuid())
  organizationId   String
  userId           String
  query            String
  resultCount      Int
  isSemanticSearch Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
}

enum BookmarkKind {
