// agent derived from a real event.
enum MemorySourceKind {
  MEETING
  DEAL
  PROPOSAL
  PROJECT
  TASK
  MANUAL
}

model AgentMemory {
  id               String     @id @default(cuid())
  agentId          String
  organizationId   String
  type             MemoryType
  // AES-256-GCM ciphertext (base64: iv + authTag + ciphertext) — see src/lib/ai/encryption.ts.
  // Never store or query plaintext here.
  encryptedContent String     @db.Text

  pinned     Boolean           @default(false)
  archivedAt DateTime?
  sourceKind MemorySourceKind?
  sourceId   String?

  agent        AIAgentInstance    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       AgentMemoryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([organizationId, type])
  @@index([agentId, pinned])
  @@index([agentId, archivedAt])
}

enum MemoryEventType {
  CREATED
  EDITED
  PINNED
  UNPINNED
  ARCHIVED
  RESTORED
  DELETED
}

// Real audit trail backing the AI Memory Manager's Memory Timeline — one row
// per real state change to a memory (never inferred/reconstructed after the
// fact). memoryId is nullable so a DELETED event can still be listed after
// the AgentMemory row itself is gone (memory's own onDelete: Cascade would
// otherwise erase its own history) — the deleted memory's last known
// (encrypted) content is preserved in `contentSnapshot` for exactly that
// case.
model AgentMemoryEvent {
  id              String          @id @default(cuid())
  memoryId        String?
  agentId         String
  organizationId  String
  eventType       MemoryEventType
  contentSnapshot String?         @db.Text
  actorUserId     String?

  memory       AgentMemory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, agentId])
  @@index([memoryId])
}

