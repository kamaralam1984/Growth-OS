enum UsageMetricType {
  AI_TOKENS
  API_CALLS
  STORAGE_MB
  PROJECTS
  CRM_RECORDS
  AUTOMATION_RUNS
  KNOWLEDGE_BASE_MB
  USERS
  WORKSPACES
  BANDWIDTH_MB
}

// Append-only usage ledger — real, timestamped events, never overwritten.
// src/lib/billing/usage-metering.ts aggregates these per period (cached in
// Redis for fast enforcement checks) rather than maintaining a separately
// mutable running counter that could drift from the real event log.
model UsageRecord {
  id               String          @id @default(cuid())
  organizationId   String
  billingAccountId String
  metricType       UsageMetricType
  quantity         Float
  periodStart      DateTime
  periodEnd        DateTime
  metadata         Json?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, metricType, periodStart])
  @@index([billingAccountId, metricType])
}

enum AIUsageProvider {
  ANTHROPIC
  OPENAI
  GOOGLE_GEMINI
  GROQ
  EMBEDDING
}

// One real row per AI call this session instruments (src/lib/ai/agent-runtime.ts,
// src/lib/rag/embeddings.ts) — inputTokens/outputTokens are the model's own
// real, reported usage (response.usage.input_tokens/output_tokens), never
// estimated. creditsUsed is derived via src/lib/billing/ai-credits.ts's
// documented per-provider conversion table.
model AIUsageEvent {
  id               String          @id @default(cuid())
  organizationId   String
  billingAccountId String
  provider         AIUsageProvider
  model            String
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  creditsUsed      Float
  context          String?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([billingAccountId, provider])
}

// One row per BillingAccount — the real, current AI-credit balance
// (monthly allotment reset each period + any separately purchased
// top-up), read on every AI call before it's allowed to proceed.
model AICreditLedger {
  id                        String    @id @default(cuid())
  billingAccountId          String    @unique
  monthlyCreditsGranted     Float     @default(0)
  monthlyCreditsUsed        Float     @default(0)
  purchasedCreditsRemaining Float     @default(0)
  periodResetAt             DateTime?

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// Global feature registry + per-org manual overrides — resolution order in
// isFeatureEnabled() is: OrganizationFeatureOverride (if any) → the org's
// current Plan's PlanFeature (if any) → FeatureFlag.defaultEnabled. Lets an
// operator flip a feature on for one org (a beta tester, a support
// workaround) without touching that org's plan.
model FeatureFlag {
  id             String  @id @default(cuid())
  key            String  @unique
  name           String
  description    String?
  defaultEnabled Boolean @default(false)

  overrides OrganizationFeatureOverride[]

  createdAt DateTime @default(now())
}

model OrganizationFeatureOverride {
  id             String  @id @default(cuid())
  organizationId String
  featureFlagId  String
  enabled        Boolean

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureFlag  FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureFlagId])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Covers both "Coupon Management" and "Promo Codes" from the spec via one
// model — `code` IS the promo code a customer types in; there is no
// separate underlying-rule-vs-human-code split (mirrors how Stripe itself
// models a coupon plus a human-friendly promotion code as the same
// concept for a system this size).
model Coupon {
