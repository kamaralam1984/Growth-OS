enum BillingPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  // Added in Phase 18 (platform Subscription/Billing/Payment Gateway) —
  // real gateway-driven lifecycle states the old 3-value enum never needed
  // back when this was just a self-service, no-charge plan/seat label.
  TRIALING
  PAUSED
  INCOMPLETE
}

// Phase 18 additions below (stripeCustomerId onward) turn this from a plain
// plan/seat label into a real platform-billing anchor — every new
// gateway/period/trial field is nullable and every new relation is
// optional-on-this-side, so the pre-existing self-service plan switcher
// (src/app/dashboard/billing/actions.ts's updateBillingPlan, still keying
// off `plan`/`seatsIncluded` exactly as before) keeps working unchanged for
// organizations that never touch real payment processing.
model BillingAccount {
  id             String        @id @default(cuid())
  organizationId String        @unique
  plan           BillingPlan   @default(FREE)
  status         BillingStatus @default(ACTIVE)
  seatsIncluded  Int           @default(5)
  renewsAt       DateTime?

  // Real platform plan (Phase 18) — distinct from the legacy `plan` enum
  // above, which stays wired to the existing free self-service switcher.
  // A gateway-driven subscription sets `currentPlanId`; `plan` is kept in
  // sync as a best-effort human-readable label, never the source of truth
  // once `currentPlanId` is set.
  currentPlanId String?
  currentPlan   Plan?   @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)

  gatewayProvider       PaymentGatewayProvider?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                 @default(false)
  canceledAt            DateTime?
  pausedAt              DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices          PlatformInvoice[]
  payments          PlatformPayment[]
  paymentMethods    PaymentMethod[]
  billingAddress    BillingAddress?
  taxProfile        TaxProfile?
  usageRecords      UsageRecord[]
  aiUsageEvents     AIUsageEvent[]
  aiCreditLedger    AICreditLedger?
  couponRedemptions CouponRedemption[]
  licenses          License[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Phase 18: Subscription, Billing, Payment Gateway, White Label & Reseller Platform =====

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  CUSTOM
}

enum BillingIntervalUnit {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

// Real, database-driven plan catalog — distinct from the legacy hardcoded
// PLAN_SEATS map in billing/actions.ts. Nullable limit fields mean
// "unlimited" (never a magic-number sentinel like -1 or 0, which would be
// ambiguous with a genuine zero-allowance plan).
model Plan {
  id              String              @id @default(cuid())
  tier            PlanTier
  name            String
  description     String?
  // Real gateway product/price ids this plan maps to, keyed by provider,
  // e.g. {"STRIPE": "price_123", "RAZORPAY": "plan_abc"} — populated once
  // an operator creates the matching Price/Plan object on each gateway's
  // own dashboard/API; a provider absent from this map simply isn't
  // purchasable via that gateway yet, never a fabricated id.
  gatewayPriceIds Json?
  interval        BillingIntervalUnit
  priceCents      Int
  currency        String              @default("USD")
  trialDays       Int                 @default(0)
  status          PlanStatus          @default(ACTIVE)
  isCustom        Boolean             @default(false)

  userLimit             Int?
  workspaceLimit        Int?
  aiCreditsMonthly      Int?
  storageMbLimit        Int?
  projectLimit          Int?
  clientLimit           Int?
  automationRunsMonthly Int?
  knowledgeBaseMbLimit  Int?
  apiCallsMonthly       Int?
  whiteLabelAccess      Boolean @default(false)
  customDomainAccess    Boolean @default(false)
  prioritySupport       Boolean @default(false)
  ssoAccess             Boolean @default(false)
  advancedAnalytics     Boolean @default(false)

  features        PlanFeature[]
  billingAccounts BillingAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tier, interval, currency])
}

// Per-plan feature toggles keyed by the same `key` FeatureFlag uses — lets
// isFeatureEnabled() (src/lib/billing/feature-flags.ts) resolve "does this
// org's plan include X" without a giant switch statement over PlanTier.
model PlanFeature {
  id      String  @id @default(cuid())
  planId  String
  key     String
  enabled Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

enum PaymentGatewayProvider {
  STRIPE
  RAZORPAY
  PAYPAL
  PADDLE
  LEMONSQUEEZY
  BANK_TRANSFER
  MANUAL
}

enum PlatformInvoiceType {
  TAX
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
  RECEIPT
  RECURRING
}

enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  REFUNDED
}

// Platform-level invoice (KVL GrowthOS billing a tenant organization for
// platform access) — a deliberately separate model/number sequence from
// the pre-existing client-facing `Invoice` (that one is an organization
// billing ITS OWN clients; conflating the two would leak platform billing
// data into a tenant's own CRM invoice list and vice versa).
model PlatformInvoice {
  id               String                @id @default(cuid())
  organizationId   String
  billingAccountId String
  invoiceNumber    String                @unique
  type             PlatformInvoiceType   @default(TAX)
  status           PlatformInvoiceStatus @default(DRAFT)
  currency         String
  subtotalCents    Int                   @default(0)
  taxCents         Int                   @default(0)
  discountCents    Int                   @default(0)
  totalCents       Int                   @default(0)
  amountPaidCents  Int                   @default(0)
  dueDate          DateTime?
  issuedAt         DateTime              @default(now())
  paidAt           DateTime?
  voidedAt         DateTime?
  gatewayInvoiceId String?
  pdfStorageKey    String?               @db.Text
  notes            String?               @db.Text

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount        @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  items          PlatformInvoiceItem[]
  payments       PlatformPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([billingAccountId, status])
}

model PlatformInvoiceItem {
  id              String @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Float  @default(1)
  unitAmountCents Int
  amountCents     Int
  order           Int    @default(0)

  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PlatformPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model PlatformPayment {
  id                  String                 @id @default(cuid())
  organizationId      String
  billingAccountId    String
  invoiceId           String?
  provider            PaymentGatewayProvider
  status              PlatformPaymentStatus  @default(PENDING)
  amountCents         Int
  currency            String
  gatewayPaymentId    String?
  gatewayChargeId     String?
  failureReason       String?                @db.Text
  refundedAmountCents Int                    @default(0)
  paidAt              DateTime?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoice        PlatformInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([billingAccountId, status])
  @@index([gatewayPaymentId])
